# dependencies
node_modules/

# note: dist/ is intentionally COMMITTED.
# Claude Code installs plugins by cloning this repo without running any
# build step, so the bundled MCP server and watcher must ship in-tree.
# lib/ is NOT: only npm/library consumers need it, and they get it from a
# pack (files includes lib) or a local `npm run build`.
# EXCEPT packages/*/lib: the dsh plugin packages build inside a dsh
# workspace checkout (scripts/sync-dsh-plugin.mjs), so their publishing
# copies ship prebuilt — the same policy as dist/.
lib/
!packages/*/lib/
!packages/*/lib/**
*.tgz

# The store is committed — the maps are this project's own history. Its
# runtime channels are not: `focus` and `quit` are one-shot messages to a
# running pane, and `viewers/` is what the live panes report about
# themselves, rewritten every second for as long as one is open.
.mellos/focus
.mellos/quit
.mellos/viewers/
