{
  // Typecheck project for the dsh plugin packages' FRAMEWORK-FREE modules and
  // the specs that cover them.
  //
  // packages/dsh and packages/dsh-client are built inside a dsh workspace
  // (scripts/sync-dsh-plugin.mjs); the framework they compile against
  // (@deepseek-ai/*, react, the JSX runtime) is supplied by the dsh loader and
  // is deliberately not a dependency here. Typechecking all of packages/*/src
  // in this repo produces 228 errors that say only "those packages are not
  // installed" — no signal. The modules listed below import nothing but
  // mellos-mapping subpaths, so they CAN be checked here, and they are also
  // the ones vitest.config.ts runs: this project and that include list cover
  // the same set on purpose.
  //
  // `paths` points the published package names at this repo's own sources, so
  // a library change that breaks the panel fails here rather than in a dsh
  // workspace weeks later.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    // The dsh workspace writes explicit `.ts` specifiers; this is `noEmit`.
    "allowImportingTsExtensions": true,
    "baseUrl": ".",
    "paths": {
      "mellos-mapping/domain/types": ["./src/domain/types.ts"],
      "mellos-mapping/domain/ops": ["./src/domain/ops.ts"],
      "mellos-mapping/semantics": ["./src/semantics/semantics.ts"],
      "mellos-mapping/render": ["./src/render/render.ts"],
      "mellos-mapping/store": ["./src/store/store.ts"],
      "mellos-mapping/format": ["./src/store/format.ts"],
      "mellos-mapping-dsh/types": ["./packages/dsh/lib/types/types.d.ts"],
      "mellos-mapping-dsh-client/src/client/*": ["./packages/dsh-client/src/client/*"]
    }
  },
  "include": [
    "packages/dsh-client/src/client/layout.ts",
    "packages/dsh-client/src/client/pages.ts",
    "packages/dsh-client/src/client/wheel.ts",
    "packages/dsh-client/tests/layout.client.spec.ts",
    "packages/dsh-client/tests/pages.client.spec.ts",
    "packages/dsh-client/tests/wheel.client.spec.ts"
  ]
}
